USE Pandoro;
GO

SELECT
    C.FullName AS Client,
    C.Phone,
    D.FullName AS Designer,
    D.WorkCost,
    S.StyleName,
    CO.ComplexityName,
    CO.ExpectedTime,
    O.OrderDate,
    O.InterimAssemblyDate,
    O.Status,
    O.ActualCompletionDate,
    MC.CategoryName,
    M.MaterialName,
    M.Price AS MaterialPrice,
    OM.Quantity,
    OM.Price AS OrderMaterialPrice
FROM Orders O
JOIN Clients C ON O.ClientID = C.ClientID
JOIN Designer D ON O.DesignerID = D.DesignerID
JOIN Styles S ON O.StyleID = S.StyleID
JOIN Complexities CO ON S.ComplexityID = CO.ComplexityID
JOIN OrderMaterials OM ON O.OrderID = OM.OrderID
JOIN Materials M ON OM.MaterialID = M.MaterialID
JOIN MaterialCategories MC ON M.CategoryID = MC.CategoryID
ORDER BY O.OrderID;
GO
