
-- ==========================================
-- 1. СОЗДАНИЕ БАЗЫ ДАННЫХ
-- ==========================================

IF DB_ID(N'Pandoro') IS NULL
    CREATE DATABASE Pandoro;
GO

USE Pandoro;
GO

-- ==========================================
-- 2. ТАБЛИЦА КЛИЕНТОВ
-- ==========================================

CREATE TABLE Clients (
    ClientID INT IDENTITY(1,1) PRIMARY KEY,
    FullName VARCHAR(150) NOT NULL,
    Phone VARCHAR(20),
    Email VARCHAR(100),
    Address VARCHAR(200)
);
GO

-- ==========================================
-- 3. ТАБЛИЦА КУКОЛЬНИКОВ
-- ==========================================

CREATE TABLE Designer (
    DesignerID INT IDENTITY(1,1) PRIMARY KEY,
    FullName VARCHAR(150) NOT NULL,
    Phone VARCHAR(20),
    WorkCost DECIMAL(12,2) NOT NULL
        CHECK (WorkCost >= 0)
);
GO

-- ==========================================
-- 4. ТАБЛИЦА СЛОЖНОСТЕЙ
-- ==========================================

CREATE TABLE Complexities (
    ComplexityID INT IDENTITY(1,1) PRIMARY KEY,
    ComplexityName VARCHAR(50) NOT NULL,
    ExpectedTime INT NOT NULL
        CHECK (ExpectedTime > 0)
);
GO

-- ==========================================
-- 5. ТАБЛИЦА ТИПОВ КУКОЛ
-- ==========================================

CREATE TABLE Styles (
    StyleID INT IDENTITY(1,1) PRIMARY KEY,
    StyleName VARCHAR(100) NOT NULL,
    Description VARCHAR(200),
    ComplexityID INT NOT NULL,

    CONSTRAINT FK_Styles_Complexities
        FOREIGN KEY (ComplexityID)
        REFERENCES Complexities(ComplexityID)
);
GO

-- ==========================================
-- 6. ТАБЛИЦА КАТЕГОРИЙ МАТЕРИАЛОВ
-- ==========================================

CREATE TABLE MaterialCategories (
    CategoryID INT IDENTITY(1,1) PRIMARY KEY,
    CategoryName VARCHAR(50) NOT NULL
);
GO

-- ==========================================
-- 7. ТАБЛИЦА МАТЕРИАЛОВ
-- ==========================================

CREATE TABLE Materials (
    MaterialID INT IDENTITY(1,1) PRIMARY KEY,
    MaterialName VARCHAR(150) NOT NULL,
    CategoryID INT NOT NULL,
    Price DECIMAL(12,2) NOT NULL
        CHECK (Price >= 0),
    Stock DECIMAL(10,2) NOT NULL DEFAULT 0
        CHECK (Stock >= 0),
    ExpectedDate DATETIME2 NULL,

    CONSTRAINT FK_Materials_Categories
        FOREIGN KEY (CategoryID)
        REFERENCES MaterialCategories(CategoryID)
);
GO

-- ==========================================
-- 8. ТАБЛИЦА ЗАКАЗОВ
-- ==========================================

CREATE TABLE Orders (
    OrderID INT IDENTITY(1,1) PRIMARY KEY,
    ClientID INT NOT NULL,
    DesignerID INT NOT NULL,
    StyleID INT NOT NULL,
    OrderDate DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    InterimAssemblyDate DATETIME2 NULL,
    Status VARCHAR(50) NOT NULL DEFAULT 'Планируется',
    ActualCompletionDate DATETIME2 NULL,

    CONSTRAINT FK_Orders_Clients
        FOREIGN KEY (ClientID)
        REFERENCES Clients(ClientID),

    CONSTRAINT FK_Orders_Designer
        FOREIGN KEY (DesignerID)
        REFERENCES Designer(DesignerID),

    CONSTRAINT FK_Orders_Styles
        FOREIGN KEY (StyleID)
        REFERENCES Styles(StyleID),

    CONSTRAINT CK_Orders_Status
        CHECK (Status IN ('Планируется', 'В процессе', 'Выполнен'))
);
GO

-- ==========================================
-- 9. ТАБЛИЦА МАТЕРИАЛОВ ЗАКАЗА
-- ==========================================

CREATE TABLE OrderMaterials (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    OrderID INT NOT NULL,
    MaterialID INT NOT NULL,
    Quantity DECIMAL(10,2) NOT NULL
        CHECK (Quantity > 0),
    Price DECIMAL(12,2) NOT NULL
        CHECK (Price >= 0),

    CONSTRAINT FK_OrderMaterials_Orders
        FOREIGN KEY (OrderID)
        REFERENCES Orders(OrderID),

    CONSTRAINT FK_OrderMaterials_Materials
        FOREIGN KEY (MaterialID)
        REFERENCES Materials(MaterialID)
);
GO

-- ==========================================
-- 10. ТАБЛИЦА МАТЕРИАЛОВ ТИПОВ КУКОЛ
-- ==========================================

CREATE TABLE StyleMaterials (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    StyleID INT NOT NULL,
    MaterialID INT NOT NULL,

    CONSTRAINT FK_StyleMaterials_Styles
        FOREIGN KEY (StyleID)
        REFERENCES Styles(StyleID),

    CONSTRAINT FK_StyleMaterials_Materials
        FOREIGN KEY (MaterialID)
        REFERENCES Materials(MaterialID),

    CONSTRAINT UQ_StyleMaterials
        UNIQUE (StyleID, MaterialID)
);
GO

